  "frames_convention": {
    "pair_template": "Kabsch-align template points onto the patch's 4 atoms, apply the same transform to template centre",
    "pair_partner_frame": "centre = mid + a*e1 + b*e2 + c*e3; e1 = unit(q - p) with chain(p) <= chain(q); e2 = unit component of (mean(partner(p), partner(q)) - mid) perpendicular to e1; e3 = e1 x e2",
